# Apogee RHBD I/O — reproducible automation flow
# Orchestrates SPICE sims, layout DRC/LVS, Verilog-A models, and regression.
#
# Primary targets: sim  layout  models  regression
# Strict shell flags ensure any non-zero tool exit fails the build.

SHELL := /bin/bash
.SHELLFLAGS := -eu -o pipefail -c
.DELETE_ON_ERROR:
.DEFAULT_GOAL := help

# ---------------------------------------------------------------------------
# Toolchain (override via environment / command line)
# ---------------------------------------------------------------------------
PYTHON   ?= python3
PYTEST   ?= $(PYTHON) -m pytest
NGSPICE  ?= ngspice
MAGIC    ?= magic
NETGEN   ?= netgen
IVERILOG ?= iverilog
VVP      ?= vvp

# Project paths
ANALOG_DIR   := analog
NETLIST_DIR  := $(ANALOG_DIR)/netlists
LAYOUT_DIR   := $(ANALOG_DIR)/layout
SIM_DIR      := $(ANALOG_DIR)/sim
MODELS_DIR   := models
SCRIPTS_DIR  := scripts
RTL_DIR      := rtl
REPORTS_DIR  := reports
BUILD_DIR    := build

# Cells with GDS + extracted/schematic SPICE for DRC/LVS
LAYOUT_CELLS ?= por LS_UP_LS_IN TOP_IO

# Self-contained behavioral sanity decks (ngspice .control scripts)
MODEL_SANITY_DECKS := \
	$(MODELS_DIR)/ls_up_sanity.sp \
	$(MODELS_DIR)/por_sanity.sp

# Hierarchical netlists loaded by the sim target (parse / include check)
SIM_NETLISTS := \
	$(NETLIST_DIR)/LS_UP.sp \
	$(NETLIST_DIR)/POR.sp \
	$(NETLIST_DIR)/por.sp \
	$(NETLIST_DIR)/TOP_IO.sp

.PHONY: help all sim layout models regression test verification \
	sim-netlists sim-models sim-postprocess \
	layout-drc layout-lvs \
	models-fit models-sanity models-check \
	clean clean-verification \
	require-tools-sim require-tools-layout \
	require-tools-models require-tools-regression

help:
	@printf '%s\n' \
		'Apogee RHBD I/O automation Makefile' \
		'' \
		'  make sim         Run SPICE netlist + Verilog-A sanity sims (ngspice)' \
		'  make layout      Run Magic DRC and Netgen LVS on layout cells' \
		'  make models      Validate / exercise Verilog-A models' \
		'  make regression  Run pytest verification regression suite' \
		'  make all         sim -> layout -> models -> regression' \
		'  make clean       Remove build and generated verification artifacts'

all: sim layout models regression

# ===========================================================================
# sim — SPICE simulations (ngspice)
# ===========================================================================
sim: require-tools-sim sim-netlists sim-models sim-postprocess
	@echo "SIM_RESULT=PASS"

require-tools-sim:
	@command -v "$(NGSPICE)" >/dev/null 2>&1 || { \
		echo "error: $(NGSPICE) not found on PATH" >&2; exit 1; }

# Load hierarchical netlists in ngspice without elaborating devices so the
# build fails on missing/broken decks even when the PDK is not mounted.
sim-netlists:
	@mkdir -p "$(BUILD_DIR)/sim"
	@status=0; \
	for netlist in $(SIM_NETLISTS); do \
		if [[ ! -f "$$netlist" ]]; then \
			echo "error: missing netlist $$netlist" >&2; status=1; continue; \
		fi; \
		base=$$(basename "$$netlist" .sp); \
		deck="$(BUILD_DIR)/sim/$${base}.load.sp"; \
		out="$(BUILD_DIR)/sim/$${base}.load.log"; \
		abs=$$(cd "$$(dirname "$$netlist")" && pwd)/$$(basename "$$netlist"); \
		printf '%s\n' \
			"* autogenerated netlist load check for $${base}" \
			".include \"$${abs}\"" \
			".control" \
			"quit" \
			".endc" \
			".end" > "$$deck"; \
		echo "==> ngspice load check $$netlist"; \
		if ! $(NGSPICE) -b -o "$$out" "$$deck"; then \
			echo "error: ngspice failed on $$netlist (see $$out)" >&2; status=1; \
		fi; \
	done; \
	exit $$status

# Behavioral / Verilog-A sanity decks (self-contained .control scripts).
sim-models:
	@mkdir -p "$(BUILD_DIR)/sim"
	@status=0; \
	for deck in $(MODEL_SANITY_DECKS); do \
		if [[ ! -f "$$deck" ]]; then \
			echo "error: missing sanity deck $$deck" >&2; status=1; continue; \
		fi; \
		base=$$(basename "$$deck" .sp); \
		out="$(BUILD_DIR)/sim/$${base}.log"; \
		echo "==> ngspice sanity $$deck"; \
		if ! (cd "$(MODELS_DIR)" && $(NGSPICE) -b -o "../$$out" "$${base}.sp"); then \
			echo "error: ngspice failed on $$deck (see $$out)" >&2; status=1; continue; \
		fi; \
		if grep -Eiq '(^Error:|fatal error|segmentation)' "$$out"; then \
			echo "error: ngspice reported errors in $$out" >&2; status=1; \
		fi; \
	done; \
	exit $$status

# Characterization post-process when ngspice .raw trees are present.
sim-postprocess:
	@if [[ -f "$(SCRIPTS_DIR)/postprocess.py" ]]; then \
		if find "$(SIM_DIR)" -name '*.raw' 2>/dev/null | grep -q .; then \
			echo "==> postprocess SPICE .raw under $(SIM_DIR)"; \
			$(PYTHON) "$(SCRIPTS_DIR)/postprocess.py" "$(SIM_DIR)" --reports "$(REPORTS_DIR)"; \
		else \
			echo "==> postprocess: no .raw files under $(SIM_DIR); skipping"; \
		fi; \
	else \
		echo "==> postprocess: $(SCRIPTS_DIR)/postprocess.py not present; skipping"; \
	fi

# ===========================================================================
# layout — Magic DRC + Netgen LVS
# ===========================================================================
layout: require-tools-layout layout-drc layout-lvs
	@echo "LAYOUT_RESULT=PASS"

require-tools-layout:
	@command -v "$(MAGIC)" >/dev/null 2>&1 || { \
		echo "error: $(MAGIC) not found on PATH" >&2; exit 1; }
	@command -v "$(NETGEN)" >/dev/null 2>&1 || { \
		echo "error: $(NETGEN) not found on PATH" >&2; exit 1; }

layout-drc:
	@mkdir -p "$(BUILD_DIR)/layout"
	@status=0; \
	for cell in $(LAYOUT_CELLS); do \
		gds="$(LAYOUT_DIR)/$${cell}.gds"; \
		if [[ ! -f "$$gds" ]]; then \
			echo "error: missing GDS $$gds" >&2; status=1; continue; \
		fi; \
		gds_abs=$$(cd "$$(dirname "$$gds")" && pwd)/$$(basename "$$gds"); \
		tcl="$(BUILD_DIR)/layout/$${cell}.drc.tcl"; \
		log="$(BUILD_DIR)/layout/$${cell}.drc.log"; \
		report="$(LAYOUT_DIR)/$${cell}.magic_drc.txt"; \
		printf '%s\n' \
			"gds read $${gds_abs}" \
			"load $${cell}" \
			"select top cell" \
			"drc euclidean on" \
			"drc check" \
			"drc catchup" \
			"set count [drc count total]" \
			"puts \"TOTAL\t\$$count\"" \
			"quit -noprompt" > "$$tcl"; \
		echo "==> Magic DRC $${cell}"; \
		if ! $(MAGIC) -dnull -noconsole < "$$tcl" >"$$log" 2>&1; then \
			echo "error: magic DRC failed for $${cell} (see $$log)" >&2; status=1; continue; \
		fi; \
		total=$$(grep -E '^TOTAL' "$$log" | tail -1 | awk '{print $$2}'); \
		echo "TOTAL	$${total:-unknown}" | tee "$$report"; \
		if [[ -z "$${total}" ]]; then \
			echo "error: could not parse DRC total for $${cell}" >&2; status=1; \
		elif [[ "$$total" != "0" ]]; then \
			echo "error: DRC errors for $${cell}: TOTAL=$$total" >&2; status=1; \
		fi; \
	done; \
	exit $$status

layout-lvs:
	@mkdir -p "$(BUILD_DIR)/layout"
	@status=0; \
	for cell in $(LAYOUT_CELLS); do \
		lay_spice="$(LAYOUT_DIR)/$${cell}.ext.spice"; \
		sch_spice="$(LAYOUT_DIR)/$${cell}.sch.spice"; \
		if [[ ! -f "$$lay_spice" ]]; then \
			echo "error: missing layout netlist $$lay_spice" >&2; status=1; continue; \
		fi; \
		if [[ ! -f "$$sch_spice" ]]; then \
			echo "error: missing schematic netlist $$sch_spice" >&2; status=1; continue; \
		fi; \
		report="$(LAYOUT_DIR)/$${cell}.lvs.txt"; \
		log="$(BUILD_DIR)/layout/$${cell}.lvs.log"; \
		echo "==> Netgen LVS $${cell}"; \
		if ! $(NETGEN) -batch lvs \
			"$${lay_spice} $${cell}" \
			"$${sch_spice} $${cell}" \
			-nojson "$$report" >"$$log" 2>&1; then \
			echo "error: netgen LVS invocation failed for $${cell} (see $$log)" >&2; status=1; continue; \
		fi; \
		if ! grep -Eq 'Final result: Circuits match uniquely\.|Netlists match uniquely\.' "$$report"; then \
			echo "error: LVS mismatch for $${cell} (see $$report)" >&2; status=1; \
		fi; \
	done; \
	exit $$status

# ===========================================================================
# models — Verilog-A model generation / validation
# ===========================================================================
models: require-tools-models models-check models-fit models-sanity
	@echo "MODELS_RESULT=PASS"

require-tools-models:
	@command -v "$(PYTHON)" >/dev/null 2>&1 || { \
		echo "error: $(PYTHON) not found on PATH" >&2; exit 1; }
	@command -v "$(NGSPICE)" >/dev/null 2>&1 || { \
		echo "error: $(NGSPICE) not found on PATH (needed for model sanity)" >&2; exit 1; }

models-check:
	@status=0; \
	for f in \
		"$(MODELS_DIR)/ls_up.va" \
		"$(MODELS_DIR)/por.va" \
		"$(MODELS_DIR)/disciplines.vams" \
		"$(MODELS_DIR)/ls_up_behav.sp" \
		"$(MODELS_DIR)/por_behav.sp"; do \
		if [[ ! -f "$$f" ]]; then \
			echo "error: missing model artifact $$f" >&2; status=1; \
		else \
			echo "==> present $$f"; \
		fi; \
	done; \
	exit $$status

models-fit:
	@status=0; \
	for script in \
		"$(MODELS_DIR)/check_ls_up_fit.py" \
		"$(MODELS_DIR)/check_por_fit.py"; do \
		if [[ ! -f "$$script" ]]; then \
			echo "error: missing fit script $$script" >&2; status=1; continue; \
		fi; \
		echo "==> $(PYTHON) $$script"; \
		if ! $(PYTHON) "$$script"; then \
			echo "error: fit check failed: $$script" >&2; status=1; \
		fi; \
	done; \
	exit $$status

models-sanity: sim-models

# ===========================================================================
# regression — pytest verification suite (Icarus + SPICE compare + coverage)
# ===========================================================================
regression: require-tools-regression verification
	@echo "REGRESSION_RESULT=PASS"

require-tools-regression:
	@command -v "$(PYTHON)" >/dev/null 2>&1 || { \
		echo "error: $(PYTHON) not found on PATH" >&2; exit 1; }
	@$(PYTHON) -c "import pytest" >/dev/null 2>&1 || { \
		echo "error: pytest not installed for $(PYTHON)" >&2; exit 1; }
	@$(PYTHON) -c "import pytest_cov" >/dev/null 2>&1 || { \
		echo "error: pytest-cov not installed for $(PYTHON)" >&2; exit 1; }

# Alias kept for compatibility with the verification-story Makefile
test: verification

verification:
	@mkdir -p "$(REPORTS_DIR)"
	$(PYTEST) -m verification \
		--cov=tests \
		--cov-config=.coveragerc \
		--cov-report=term-missing \
		--cov-report=xml:$(REPORTS_DIR)/coverage.xml \
		--cov-fail-under=99
	@echo "VERIFICATION_RESULT=PASS"

clean-verification:
	rm -rf \
		$(REPORTS_DIR)/verification_artifacts \
		$(REPORTS_DIR)/verification_coverage.json \
		$(REPORTS_DIR)/verification_coverage.txt \
		$(REPORTS_DIR)/coverage.xml \
		.coverage \
		htmlcov \
		$(RTL_DIR)/tb_top_io.vvp \
		$(RTL_DIR)/tb_top_io.vcd

clean: clean-verification
	rm -rf $(BUILD_DIR)
